{
  "id": "com.scrapsetu.app",
  "name": "ScrapSetu - Smart Scrap Marketplace",
  "short_name": "ScrapSetu",
  "description": "AI-assisted waste classification, fair pricing, and digital ledger connecting informal scrap collectors to authorized recyclers.",
  "theme_color": "#0F1A3C",
  "background_color": "#0F1A3C",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "start_url": "/",
  "scope": "/",
  "categories": ["business", "productivity", "utilities"],
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Start Scrap Collection",
      "short_name": "Collect",
      "description": "Scan and classify scrap waste",
      "url": "/?action=scan",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "View Ledger & Earnings",
      "short_name": "Ledger",
      "description": "Open digital scrap passbook",
      "url": "/?action=ledger",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192" }]
    }
  ]
}
