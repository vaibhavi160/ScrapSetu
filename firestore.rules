rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 1. Users collection (User Profiles)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // 2. Scrap Categories (Public rate cards & safety guidelines)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 3. Recyclers Directory (Public verified facilities)
    match /recyclers/{recyclerId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 4. Completed Transactions
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (resource == null || resource.data.collectorId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.collectorId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.collectorId == request.auth.uid;
      allow delete: if false;
    }

    // 5. Doorstep Pickups
    match /pickups/{pickupId} {
      allow read, write: if isSignedIn();
      allow delete: if false;
    }

    // 6. Test connection / health check
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}

